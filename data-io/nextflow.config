// ---------------------------------------------------------------------------
// data-io - hot (Lustre) vs cold (Alluxio) storage IO benchmark
// ---------------------------------------------------------------------------
//   nextflow run main.nf --arm verify   -profile cluster     both tiers
//   nextflow run main.nf --arm illumina -profile cluster --tier hot
//   nextflow run main.nf --arm pacbio   -profile cluster --tier hot --device gpu
//   nextflow run main.nf --arm ont      -profile cluster --tier hot
//   nextflow run main.nf --arm summary  -profile cluster     hot vs cold
//
// READ from the tier under test (--tier); WRITE everything to Lustre:
//
//   <tier root>/tests/data-io/input/<platform>/   reads you stage
//   <tier root>/references/                       reference fastas
//
//   <lustre>/tests/data-io/work/                  nextflow work dir
//   <lustre>/tests/data-io/results/<run>/         everything a run produced
//
// Only reads vary by tier. Alluxio is measured as a data source, not used as a
// working or publishing filesystem - it cannot host the work dir (see below),
// and keeping results beside it means one place to look. --out_tier cold moves
// the results onto Alluxio if you want to test writing to it.
//
// Every run writes to one results tree, so there is one place to look and one
// folder per run: results/hot-illumina/, results/cold-illumina/, and so on.
// Nothing lands in the directory you launched from.

manifest {
    name              = 'data-io'
    author            = 'EIT Generative Biology Institute'
    description       = 'Storage IO benchmark: hot (Lustre) vs cold (Alluxio)'
    version           = '0.2.0'
    mainScript        = 'main.nf'
    nextflowVersion   = '!>=25.04.0'
    recurseSubmodules = true
}

// ---------------------------------------------------------------------------
// Parameters - the whole surface
// ---------------------------------------------------------------------------
params {
    arm      = null     // verify | illumina | pacbio | ont | summary
    tier     = 'hot'    // hot | cold   - which storage is READ, the thing under test
    out_tier = 'hot'    // hot | cold   - where RESULTS are published
    device   = 'cpu'    // cpu | gpu    - pacbio only
    reps     = 1        // verify only  - read every file this many times

    // The Nextflow work dir: an explicit path on Lustre, for BOTH tiers. It is
    // not derived from --tier or --out_tier, so a cold run reads Alluxio and
    // works on Lustre.
    //
    // Alluxio cannot host it. Nextflow polls the work dir for each task's
    // .exitcode file, and a cache over object storage does not give that the
    // immediate metadata visibility it needs, so tasks come back as
    //   "terminated for an unknown reason -- Likely it has been terminated by
    //    the external system"
    // with no exit status, even though they ran fine.
    // (defaulted below, where hot_root has a value)
    work_dir = null

    hot_root  = '/mnt/lustre/projects/bioinformatics'
    cold_root = '/mnt/user-data/cristian-soitu/bioinformatics'

    // Reference fasta per platform, relative to <root>/references/.
    // Indexes are built automatically when missing.
    ref_illumina = 'ecoli/syn57/syn57_evo/Syn57_evo2.fa'
    ref_pacbio   = 'plasmids/plasmids/pFR494_pRT300_rham_wt.fa'
    ref_ont      = 'other/simon_methylation/wt-0248-tdk_kan.fa'

    // Read by the dorado module itself, so the names are fixed
    basecalling.model          = '/opt/models/dna_r10.4.1_e8.2_400bps_sup@v5.0.0'
    basecalling.modified_bases = ''
}

// ---------------------------------------------------------------------------
// Where this run reads and writes
// ---------------------------------------------------------------------------
// Command-line params are applied before this block, so --tier and --device
// both reach it. (A -profile would not: profile values land afterwards.)
// read side
params.root          = params.tier == 'cold' ? params.cold_root : params.hot_root
params.input_dir     = "${params.root}/tests/data-io/input"
params.reference_dir = "${params.root}/references"

// write side
params.out_root = params.out_tier == 'hot' ? params.hot_root : params.cold_root
params.out_base = "${params.out_root}/tests/data-io"

// Defaulted here rather than in the params block: params cannot reference each
// other while that block is still being built. `?:` keeps a --work_dir override.
params.work_dir = params.work_dir ?: "${params.hot_root}/tests/data-io/work"

// A hard link is free but needs one filesystem; publishing from the work dir to
// the other tier has to copy.
params.publish_mode = params.work_dir.startsWith(params.out_root) ? 'link' : 'copy'

// The read tier is in the folder name, so hot and cold runs of the same arm sit
// side by side in one results tree instead of overwriting each other.
params.run    = params.arm == 'verify' || params.arm == 'summary'
                    ? "${params.arm}"
                    : (params.arm == 'pacbio'
                        ? "${params.tier}-pacbio-${params.device}"
                        : "${params.tier}-${params.arm}")
params.outdir = "${params.out_base}/results/${params.run}"

workDir   = params.work_dir
outputDir = params.outdir

// ---------------------------------------------------------------------------
// Containers
// ---------------------------------------------------------------------------
includeConfig 'modules/bwa/conf/module.config'
includeConfig 'modules/samtools/conf/module.config'
includeConfig 'modules/parabricks/conf/module.config'

process {
    withName: 'MINIMAP2_.*' { container = 'ghcr.io/eit-gbi/nf-mod-minimap2:latest' }
    withName: 'DORADO_.*'   { container = 'ghcr.io/eit-gbi/nf-mod-dorado:latest'   }

    // python:3.12, NOT -slim: the slim image has no `ps`, which Nextflow needs
    // to collect task metrics, and the task dies without it.
    withName: 'SAMPLESHEET_.*|REPORT_.*' { container = 'python:3.12'; cpus = 1 }
    withName: 'READ_FILE|COMPARE_BAM'    { container = 'ghcr.io/eit-gbi/nf-mod-samtools:v1.0.0' }

    // Nothing publishes unless named below: otherwise every intermediate lands
    // in the run folder, and BWA_MEM's BAM would appear twice because
    // SAMTOOLS_INDEX re-emits it.
    //
    // params.publish_mode is 'link' when the work dir and the results share a
    // filesystem and 'copy' when they do not. Linking matters on Lustre because
    // Java 21+ copies with copy_file_range, which Lustre answers with ENODATA.
    withName: 'SAMTOOLS_INDEX|PARABRICKS_MINIMAP2|DORADO_ALIGNER' {
        publishDir = [path: "${params.outdir}/alignment", mode: params.publish_mode]
    }
    withName: 'DORADO_BASECALLER' {
        publishDir = [path: "${params.outdir}/basecalled", mode: params.publish_mode]
    }
    withName: 'SAMTOOLS_FLAGSTAT' {
        publishDir = [path: "${params.outdir}/qc", mode: params.publish_mode]
    }
    withName: 'SAMPLESHEET_.*' {
        publishDir = [path: "${params.outdir}", mode: params.publish_mode]
    }
    withName: 'BWA_INDEX|SAMTOOLS_FAIDX' {
        publishDir = [path: "${params.outdir}/index", mode: params.publish_mode]
    }
    withName: 'REPORT_.*' {
        publishDir = [path: "${params.outdir}", mode: params.publish_mode]
    }

    // 'finish' not 'retry': a retry would re-read on a warm cache and quietly
    // replace a first-touch measurement with a warm one.
    errorStrategy = 'finish'
    maxRetries    = 0
    ext.args      = ''
    cpus          = 4
}

profiles {
    cluster {
        docker.enabled       = false
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = '/mnt/lustre/containers/.staging/nf/cache'
        // Both tiers plus the checkout: verify reads both, and the .py scripts
        // are staged from wherever the pipeline is checked out.
        apptainer.runOptions = '-B /mnt/lustre -B /mnt/user-data -B /mnt/gbi-shared'

        process.executor = 'slurm'
        process.queue    = 'cpu'

        process {
            withName: 'BWA_.*'            { cpus = 16; memory = '32 GB'; time = '24 h' }
            withName: 'MINIMAP2_ALIGN'    { cpus = 8;  memory = '48 GB'; time = '24 h' }
            withName: 'SAMTOOLS_FASTQ'    { cpus = 4;  memory = '48 GB'; time = '12 h' }
            withName: 'SAMTOOLS_.*'       { cpus = 4;  memory = '16 GB'; time = '6 h'  }
            withName: 'READ_FILE|COMPARE_BAM' { cpus = 2; memory = '8 GB'; time = '6 h' }

            withName: 'PARABRICKS_.*' {
                cpus = 12; memory = '64 GB'; time = '24 h'
                accelerator = 2; clusterOptions = '--gres=gpu:2'
                queue = 'gpu'; containerOptions = '--nv'
            }
            withName: 'DORADO_BASECALLER' {
                cpus = 8; memory = '96 GB'; time = '48 h'
                accelerator = 1; clusterOptions = '--gres=gpu:1'
                queue = 'gpu'; containerOptions = '--nv'
            }
            withName: 'DORADO_ALIGNER' {
                cpus = 8; memory = '48 GB'; time = '24 h'
                accelerator = 1; clusterOptions = '--gres=gpu:1'
                queue = 'gpu'; containerOptions = '--nv'
            }
        }
    }
    docker { docker.enabled = true; apptainer.enabled = false }
}

// ---------------------------------------------------------------------------
// One trace, one report, one timeline - in this run's own folder
// ---------------------------------------------------------------------------
// No timestamp in the names: re-running an arm overwrites its own folder rather
// than leaving another dated copy to sift through.
//
// raw = true keeps the numbers machine-readable. `rchar` is the field that
// matters: it counts bytes read by syscalls, so it is comparable across tiers.
// `read_bytes` counts block-device IO and reads 0 on Alluxio, which serves over
// the network.
// Only instrument a real arm, so a bad --arm does not leave a stray folder
// behind in the results tree.
trace {
    enabled = params.arm in ['verify', 'illumina', 'pacbio', 'ont', 'summary']
    overwrite = true; raw = true
    file    = "${params.outdir}/trace.txt"
    fields  = 'task_id,process,tag,status,exit,start,complete,realtime,%cpu,peak_rss,rchar,wchar,read_bytes,write_bytes'
}
report {
    enabled = params.arm in ['verify', 'illumina', 'pacbio', 'ont', 'summary']
    overwrite = true; file = "${params.outdir}/report.html"
}
timeline {
    enabled = params.arm in ['verify', 'illumina', 'pacbio', 'ont', 'summary']
    overwrite = true; file = "${params.outdir}/timeline.html"
}
