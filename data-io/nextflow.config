// ---------------------------------------------------------------------------
// data-io - hot (Lustre) vs cold (Alluxio) storage IO benchmark
// ---------------------------------------------------------------------------
// Everything runs through main.nf. Pick an arm with --arm:
//
//   nextflow run main.nf --arm verify                     # both tiers, integrity
//   nextflow run main.nf --arm illumina --tier hot
//   nextflow run main.nf --arm pacbio   --tier cold --device gpu
//   nextflow run main.nf --arm ont      --tier hot
//   nextflow run main.nf --arm compare                    # hot vs cold outputs
//   nextflow run main.nf --arm report                     # timing table
//
// There are no helper scripts and nothing to run beforehand: stage the reads
// into <root>/tests/data-io/input/<platform>/ and every arm builds what it
// needs. See README.md.

manifest {
    name              = 'data-io'
    author            = 'EIT Generative Biology Institute'
    homePage          = 'https://github.com/EIT-GBI/bioinf-tests'
    description       = 'Storage IO benchmark: hot (Lustre) vs cold (Alluxio)'
    version           = '0.1.0'
    mainScript        = 'main.nf'
    nextflowVersion   = '!>=25.04.0'
    recurseSubmodules = true    // the tool modules are git submodules
}

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------
params {
    // The two storage tiers. Both are always known, because the integrity and
    // comparison arms read them side by side in a single run.
    hot_root    = '/mnt/lustre/projects/bioinformatics'
    cold_root   = '/mnt/user-data/cristian-soitu/bioinformatics'
    test_subdir = 'tests/data-io'

    // Which arm to run: verify | illumina | pacbio | ont | compare | report.
    // A param rather than -entry, which Nextflow 26's strict syntax removed.
    arm = null

    // Which tier the workload arms read. The verify and compare arms ignore it
    // for their inputs - they read both - and use it only to place the work dir.
    tier = 'hot'

    // Repeat number. It only labels the trace file, so reps stay distinguishable.
    rep = 1

    // Cross-tier artefacts: traces, the verify CSV and report, the timing table.
    // Relative to wherever you launch, so launch from a shared filesystem.
    results = 'results'

    // Optional: skip samplesheet building and use this one instead
    samplesheet = null

    // Reference per platform, relative to <root>/references/
    references.illumina = 'ecoli/syn57/syn57_evo/Syn57_evo2.fa'
    references.pacbio   = 'plasmids/plasmids/pFR494_pRT300_rham_wt.fa'
    references.ont      = 'other/simon_methylation/wt-0248-tdk_kan.fa'

    // Top level on purpose. A nested `--pacbio.device gpu` on the command line
    // does NOT reach values this config derives below (a top-level `--tier`
    // does), so the run label would silently keep saying 'cpu' and the GPU run
    // would overwrite the CPU run's outputs and trace.
    device     = 'cpu'     // pacbio: 'cpu' = minimap2 | 'gpu' = pbrun minimap2
    input_type = 'ubam'    // pacbio: 'ubam' | 'fastq'

    // Named `basecalling` because the dorado module reads these itself
    basecalling.model          = '/opt/models/dna_r10.4.1_e8.2_400bps_sup@v5.0.0'
    basecalling.modified_bases = ''

    // How many times verify re-reads each file. Disagreement between reps is
    // the signature of read-path corruption.
    reps = 3
}

// ---------------------------------------------------------------------------
// Paths derived from the chosen tier
// ---------------------------------------------------------------------------
// Command-line params are applied before this runs, so --tier cold reaches
// every line below. (A profile would not: profile values land after the config
// body, which is why the tier is a plain param here and not a profile.)
params.storage_root  = params.tier == 'cold' ? params.cold_root : params.hot_root

// Read from the tier under test. The reference and its indexes count as reads
// too - pulling the bwa index is part of the access pattern being measured.
params.input_dir     = "${params.storage_root}/${params.test_subdir}/input"
params.reference_dir = "${params.storage_root}/references"

// Everything WRITTEN goes to Lustre, whichever tier is being read, for three
// reasons:
//   1. Nextflow's work dir needs POSIX semantics - atomic rename, locking, a
//      lot of small metadata operations. Alluxio is a cache over object
//      storage and is weak at exactly those, so a cold run could fail or crawl
//      for reasons that have nothing to do with read performance, and would
//      look like "Alluxio is slow".
//   2. It isolates the variable. The corruption appeared on the read path;
//      writing intermediates to cold as well would mix read and write into one
//      unattributable number.
//   3. It matches how the tier is actually used: data sits on Alluxio, compute
//      reads it, results land on fast scratch. Nothing uses a cache layer as
//      scratch.
// The trade-off is that this measures the READ path, not end-to-end cold. If
// writing to Alluxio also matters, that deserves its own test rather than
// being folded into this one.
// What distinguishes one run from another: the arm, plus the device for pacbio,
// which is the one arm that runs twice per cell. Used for both the output
// directory and the trace/report/timeline filenames, so two runs of the same
// cell cannot overwrite each other - which matters as soon as the arms are
// launched in parallel rather than one after another.
params.run_label = "${params.arm}${params.arm == 'pacbio' ? '-' + params.device : ''}"

// One directory per run label, so the arms cannot overwrite each other's BAMs.
params.outdir = "${params.hot_root}/${params.test_subdir}/output/${params.tier}/${params.run_label}"

workDir   = "${params.hot_root}/${params.test_subdir}/work"
outputDir = params.outdir

// ---------------------------------------------------------------------------
// Module containers
// ---------------------------------------------------------------------------
// bwa, samtools and parabricks publish a conf/module.config pinned to their
// release tag, so include those rather than restating the image.
includeConfig 'modules/bwa/conf/module.config'
includeConfig 'modules/samtools/conf/module.config'
includeConfig 'modules/parabricks/conf/module.config'

process {
    // minimap2 and dorado have no module.config in their repos (both untagged),
    // so pin their images here - as nf-dnaseq-long and nf-dnaseq-ont do.
    withName: 'MINIMAP2_.*' { container = 'ghcr.io/eit-gbi/nf-mod-minimap2:latest' }
    withName: 'DORADO_.*'   { container = 'ghcr.io/eit-gbi/nf-mod-dorado:latest'   }

    // Local processes, split by what they actually need. The samtools image is
    // debian-slim plus samtools: it has bash, coreutils, findutils, gzip and
    // awk, but no python - so anything running a .py script needs the python
    // image instead. (nf-dnaseq uses the same one for its samplesheet step.)
    withName: 'PREPARE_SAMPLESHEET_.*|VERIFY_REPORT|TIMING_REPORT' {
        container = 'python:3.12-slim'
        cpus      = 1
    }
    // VERIFY_READ needs md5sum, gzip -t and samtools quickcheck; COMPARE_BAM
    // needs samtools view.
    withName: 'VERIFY_READ|COMPARE_BAM' {
        container = 'ghcr.io/eit-gbi/nf-mod-samtools:v1.0.0'
    }

    // At their pinned releases the bwa, samtools, minimap2 and parabricks
    // modules declare no publishDir of their own, so the output layout is set
    // here. Keeping every arm's BAM in one alignment/ folder is what lets
    // `--arm compare` find them without knowing which arm produced them.
    withName: 'SAMTOOLS_INDEX|PARABRICKS_MINIMAP2|DORADO_ALIGNER' {
        publishDir = [path: "${params.outdir}/alignment", mode: 'copy']
    }
    withName: 'SAMTOOLS_FLAGSTAT' {
        publishDir = [path: "${params.outdir}/qc", mode: 'copy']
    }

    // 'finish' rather than 'retry': a retry would re-read the input on a warm
    // cache and quietly replace a first-touch measurement with a warm one.
    errorStrategy = 'finish'
    maxRetries    = 0
    ext.args      = ''
    cpus          = 4
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    cluster {
        docker.enabled       = false
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = '/mnt/lustre/containers/.staging/nf/cache'
        // Both tiers bound always: verify and compare read them side by side.
        apptainer.runOptions = '-B /mnt/lustre -B /mnt/user-data'

        process.executor = 'slurm'
        process.queue    = 'cpu'

        process {
            // Resources mirror the pipelines these modules come from, so the
            // benchmark sees the same task shape as a real run.
            withName: 'BWA_.*'                          { cpus = 16; memory = '32 GB'; time = '24 h' }
            withName: 'MINIMAP2_ALIGN'                  { cpus = 8;  memory = '48 GB'; time = '24 h' }
            withName: 'SAMTOOLS_FASTQ'                  { cpus = 4;  memory = '48 GB'; time = '12 h' }
            withName: 'SAMTOOLS_(FAIDX|FLAGSTAT|INDEX)' { cpus = 4;  memory = '16 GB'; time = '6 h'  }
            withName: 'VERIFY_READ|COMPARE_BAM'         { cpus = 2;  memory = '8 GB';  time = '6 h'  }

            withName: 'PARABRICKS_.*' {
                cpus             = 12
                memory           = '64 GB'
                accelerator      = 2
                clusterOptions   = '--gres=gpu:2'   // keep count == accelerator
                queue            = 'gpu'
                containerOptions = '--nv'
                time             = '24 h'
            }
            withName: 'DORADO_BASECALLER' {
                cpus             = 8
                memory           = '96 GB'
                accelerator      = 1
                clusterOptions   = '--gres=gpu:1'
                queue            = 'gpu'
                containerOptions = '--nv'
                time             = '48 h'
            }
            withName: 'DORADO_ALIGNER' {
                cpus             = 8
                memory           = '48 GB'
                accelerator      = 1
                clusterOptions   = '--gres=gpu:1'
                queue            = 'gpu'
                containerOptions = '--nv'
                time             = '24 h'
            }
        }
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        apptainer.enabled = false
    }
}

// ---------------------------------------------------------------------------
// Instrumentation - on by default, so there are no flags to remember
// ---------------------------------------------------------------------------
// The run label, tier and rep are all in the filename, which is how
// `--arm report` knows what a trace was without any bookkeeping file. The timestamp keeps
// repeated runs of the same cell from overwriting each other.
//
// It is a param rather than a local variable for two reasons: Nextflow 26's
// config parser rejects `def` declarations outright, and a param is evaluated
// once, so the trace, report and timeline of one run cannot end up with stamps
// a second apart. Pass --stamp to give a run a label of your own.
params.stamp = new java.util.Date().format('yyyyMMdd-HHmmss')

// raw = true keeps the numbers machine-readable: durations in milliseconds and
// sizes in bytes, rather than "2m 30s" and "1.2 GB".

trace {
    enabled   = true
    overwrite = true
    raw       = true
    file      = "${params.results}/trace-${params.run_label}-${params.tier}-rep${params.rep}-${params.stamp}.txt"
    // start/complete are carried so a run's wall clock, and therefore its
    // aggregate throughput, stays recoverable later. Under fan-out the per-task
    // MB/s is only each task's share; total bytes over elapsed time is the
    // honest whole-run number, and it cannot be reconstructed afterwards if
    // these are not recorded now.
    fields    = 'task_id,process,tag,status,exit,submit,start,complete,realtime,duration,%cpu,peak_rss,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

report {
    enabled = true
    overwrite = true
    file    = "${params.results}/report-${params.run_label}-${params.tier}-rep${params.rep}-${params.stamp}.html"
}

timeline {
    enabled = true
    overwrite = true
    file    = "${params.results}/timeline-${params.run_label}-${params.tier}-rep${params.rep}-${params.stamp}.html"
}
