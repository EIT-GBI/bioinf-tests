// ---------------------------------------------------------------------------
// data-io - hot (Lustre) vs cold (Alluxio) storage IO benchmark
// ---------------------------------------------------------------------------
// Four entry scripts, one config:
//     verify.nf     read integrity + raw throughput, no tools
//     illumina.nf   bwa mem -> index -> flagstat
//     pacbio.nf     (ubam -> fastq) -> minimap2 | pbrun minimap2 -> flagstat
//     ont.nf        dorado basecaller (sup) -> dorado aligner -> flagstat
//
// The storage tier is a profile, not a second copy of the pipeline: both arms
// must run byte-identical code or code drift confounds the comparison.
//
//     nextflow run illumina.nf -profile cluster,hot -params-file params.yaml
//
// Every path on a tier derives from that tier's one root, set in the hot/cold
// profiles below.

manifest {
    name              = 'data-io'
    author            = 'EIT Generative Biology Institute'
    homePage          = 'https://github.com/EIT-GBI/bioinf-tests'
    description       = 'Storage IO benchmark: hot (Lustre) vs cold (Alluxio)'
    version           = '0.1.0'
    nextflowVersion   = '!>=25.04.0'
    recurseSubmodules = true    // the tool modules are git submodules
}

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------
params {
    // Set by the hot/cold profiles, not by hand
    tier         = null
    storage_root = null

    // Optional override. By default each entry script builds its samplesheet
    // from that tier's input folder.
    samplesheet = null

    // Reference per platform, relative to <storage_root>/references/
    references.illumina = 'ecoli/syn57/syn57_evo/Syn57_evo2.fa'
    references.pacbio   = 'plasmids/plasmids/pFR494_pRT300_rham_wt.fa'
    references.ont      = 'other/simon_methylation/wt-0248-tdk_kan.fa'

    pacbio.input_type = 'ubam'    // 'ubam' | 'fastq'
    pacbio.device     = 'cpu'     // 'cpu' = minimap2 | 'gpu' = pbrun minimap2

    // Named `basecalling` because the dorado module reads these itself
    basecalling.model          = '/opt/models/dna_r10.4.1_e8.2_400bps_sup@v5.0.0'
    basecalling.modified_bases = ''

    verify.reps = 3
}

// ---------------------------------------------------------------------------
// Module containers
// ---------------------------------------------------------------------------
// bwa, samtools and parabricks publish a conf/module.config pinned to their
// release tag, so include those rather than restating the image.
includeConfig 'modules/bwa/conf/module.config'
includeConfig 'modules/samtools/conf/module.config'
includeConfig 'modules/parabricks/conf/module.config'

// minimap2 and dorado have no module.config in their repos (both untagged, at
// version 0.0.0), so pin their images here - as nf-dnaseq-long and
// nf-dnaseq-ont do.
process {
    withName: 'MINIMAP2_.*' { container = 'ghcr.io/eit-gbi/nf-mod-minimap2:latest' }
    withName: 'DORADO_.*'   { container = 'ghcr.io/eit-gbi/nf-mod-dorado:latest'   }
    // Local process: needs coreutils, gzip -t and samtools quickcheck, all of
    // which the samtools image already has.
    withName: 'VERIFY_READ' { container = 'ghcr.io/eit-gbi/nf-mod-samtools:v1.0.0' }
    // The samplesheet builders run a bundled python script (or plain bash for
    // the POD5 one), so they need an interpreter rather than a tool image.
    withName: 'PREPARE_SAMPLESHEET_.*' {
        container = 'python:3.12-slim'
        cpus      = 1
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    hot {
        params.tier         = 'hot'
        params.storage_root = '/mnt/lustre/projects/bioinformatics'
    }
    cold {
        params.tier         = 'cold'
        params.storage_root = '/mnt/user-data/cristian-soitu/bioinformatics'
    }

    cluster {
        docker.enabled       = false
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = '/mnt/lustre/containers/.staging/nf/cache'
        // Both tiers bound in both cases: cheap, and it stops a wrong-tier
        // path failing in a way that looks like an IO error.
        apptainer.runOptions = '-B /mnt/lustre -B /mnt/user-data'

        process.executor = 'slurm'
        process.queue    = 'cpu'

        process {
            // Resources mirror the pipelines these modules come from, so the
            // benchmark sees the same task shape as a real run.
            withName: 'BWA_.*'                          { cpus = 16; memory = '32 GB'; time = '24 h' }
            withName: 'MINIMAP2_ALIGN'                  { cpus = 8;  memory = '48 GB'; time = '24 h' }
            withName: 'SAMTOOLS_FASTQ'                  { cpus = 4;  memory = '48 GB'; time = '12 h' }
            withName: 'SAMTOOLS_(FAIDX|FLAGSTAT|INDEX)' { cpus = 4;  memory = '16 GB'; time = '6 h'  }
            withName: 'VERIFY_READ'                     { cpus = 2;  memory = '8 GB';  time = '6 h'  }

            withName: 'PARABRICKS_.*' {
                cpus             = 12
                memory           = '64 GB'
                accelerator      = 2
                clusterOptions   = '--gres=gpu:2'   // keep count == accelerator
                queue            = 'gpu'
                containerOptions = '--nv'
                time             = '24 h'
            }
            withName: 'DORADO_BASECALLER' {
                cpus             = 8
                memory           = '96 GB'
                accelerator      = 1
                clusterOptions   = '--gres=gpu:1'
                queue            = 'gpu'
                containerOptions = '--nv'
                time             = '48 h'
            }
            withName: 'DORADO_ALIGNER' {
                cpus             = 8
                memory           = '48 GB'
                accelerator      = 1
                clusterOptions   = '--gres=gpu:1'
                queue            = 'gpu'
                containerOptions = '--nv'
                time             = '24 h'
            }
        }
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        apptainer.enabled = false
    }
}

// ---------------------------------------------------------------------------
// Process defaults
// ---------------------------------------------------------------------------
process {
    // 'finish' rather than 'retry': a retry would re-read the input on a warm
    // cache and quietly replace a first-touch measurement with a warm one.
    errorStrategy = 'finish'
    maxRetries    = 0
    ext.args      = ''
    cpus          = 4
}

// ---------------------------------------------------------------------------
// Paths derived from the tier's root
// ---------------------------------------------------------------------------
// This block must come AFTER `profiles`, because it reads the value a tier
// profile just set. One root per tier is the whole difference between the arms.
params.reference_dir = "${params.storage_root}/references"
params.input_dir     = "${params.storage_root}/tests/data-io/input"
params.outdir        = "${params.storage_root}/tests/data-io/output"

// The work dir lives on the tier under test, so reads AND writes go through it
// and each arm measures that filesystem end to end. The ternary keeps
// `nextflow config` usable without a tier profile.
workDir   = params.storage_root ? "${params.storage_root}/tests/data-io/work" : 'work'
outputDir = params.outdir

// ---------------------------------------------------------------------------
// Instrumentation
// ---------------------------------------------------------------------------
// raw = true is what keeps bin/collect_traces.sh simple: durations come out as
// plain milliseconds and sizes as plain bytes, instead of "2m 30s" and "1.2 GB"
// that a script would have to parse back.
trace {
    overwrite = true
    raw       = true
    fields    = 'task_id,process,tag,status,exit,realtime,duration,%cpu,peak_rss,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

report   { overwrite = true }
timeline { overwrite = true }
