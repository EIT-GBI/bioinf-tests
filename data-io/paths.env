# Storage paths for the bin/ scripts. Sourced, so it is plain shell.
#
# The pipelines do NOT read this file - they get their paths from the hot/cold
# profiles in nextflow.config. Both must agree; these are the same two roots.
#
# paths.txt is the human-readable note. This is the machine-readable one: the
# names there use hyphens, which cannot be shell variables (and `${HOT-STORAGE-DIR}`
# silently parses as "${HOT} defaulting to -STORAGE-DIR").

HOT_ROOT=/mnt/lustre/projects/bioinformatics
COLD_ROOT=/mnt/user-data/cristian-soitu/bioinformatics

TEST_DIR=tests/data-io

# Reference fastas, relative to <root>/references/. Index files (.fai, .bwt, ...)
# are picked up automatically as siblings.
REFERENCES="
ecoli/syn57/syn57_evo/Syn57_evo2.fa
plasmids/plasmids/pFR494_pRT300_rham_wt.fa
other/simon_methylation/wt-0248-tdk_kan.fa
"

# Root for a tier name. Every script uses this instead of its own case block.
root_for() {
    case "$1" in
        hot)  echo "$HOT_ROOT" ;;
        cold) echo "$COLD_ROOT" ;;
        *)    echo "unknown tier: $1 (use hot or cold)" >&2; return 1 ;;
    esac
}
