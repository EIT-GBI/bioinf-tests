// Same roots as data-io. Override both for a local test.
params {
    hot_root  = '/mnt/lustre/projects/bioinformatics'
    cold_root = '/mnt/user-data/cristian-soitu/bioinformatics'
}

params.hot_out  = "${params.hot_root}/tests/publish-two-dirs/results"
params.cold_out = "${params.cold_root}/tests/publish-two-dirs/results"

// Work dir on hot, as in data-io: Alluxio cannot host it.
workDir = "${params.hot_root}/tests/publish-two-dirs/work"

// Nothing should land here - both outputs use absolute paths.
outputDir = "${params.hot_root}/tests/publish-two-dirs/unused"

// Plain bash, no container: MAKE only runs echo.
profiles {
    cluster {
        process.executor = 'slurm'
        process.queue    = 'cpu'
    }
}
